) {\n            return images[imageIndex].img_dsc;\n        }\n    }\n    return 0;\n}\n\nvoid loadScreen(enum ScreensEnum screenId) {\n    currentScreen = screenId - 1;\n    lv_obj_t *screen = getLvglObjectFromIndex(currentScreen);\n    lv_scr_load_anim(screen, LV_SCR_LOAD_ANIM_FADE_IN, 200, 0, false);\n}\n\nvoid ui_init() {\n    create_screens();\n    loadScreen(SCREEN_ID_MAIN);\n}\n\nvoid ui_tick() {\n    tick_screen(currentScreen);\n}\n\n#endif\n"}],"destinationFolder":"src/ui","separateFolderForImagesAndFonts":false,"imageExportMode":"source","fontExportMode":"source","fileSystemPath":"","lvglInclude":"lvgl/lvgl.h","screensLifetimeSupport":true,"useDockerDesktop":false,"generateSourceCodeForEezFramework":false,"compressFlowDefinition":false,"executionQueueSize":1000,"expressionEvaluatorStackSize":20}},"variables":{"objID":"6ebbc892-f49a-46ef-a25f-6f05be44e3bb","globalVariables":[{"objID":"13f9e8d0-fba9-4930-8b42-a589ce0efc4b","name":"rideStartTick","type":"integer","defaultValue":"0","native":false,"persistent":false},{"objID":"65d46c01-64c7-44a1-af9c-5c8b5847ddf1","name":"rideActive","type":"boolean","defaultValue":"false","native":false,"persistent":false}],"structures":[],"enums":[]},"actions":[],"userPages":[{"objID":"8da064f3-122e-4d93-b60c-99e868462cf3","components":[{"objID":"deb9f4d9-2509-4711-9664-cc868e59d142","type":"LVGLScreenWidget","left":0,"top":0,"width":800,"height":480,"customInputs":[],"customOutputs":[],"style":{"objID":"84683ae9-b005-471b-bfb2-74a605210d75","useStyle":"default","conditionalStyles":[],"childStyles":[]},"timeline":[],"eventHandlers":[],"leftUnit":"px","topUnit":"px","widthUnit":"px","heightUnit":"px","children":[{"objID":"0051e458-2d19-4f85-b95a-8b74fb473298","type":"LVGLLabelWidget","left":36,"top":28,"width":360,"height":48,"customInputs":[],"customOutputs":[],"style":{"objID":"7708bafb-9800-4378-b29b-bf8dcb93232a","useStyle":"default","conditionalStyles":[],"childStyles":[]},"timeline":[],"eventHandlers":[],"leftUnit":"px