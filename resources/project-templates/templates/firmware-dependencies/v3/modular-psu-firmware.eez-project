        "toolbarButtonColor": "#C1D751",
        "requiresConfirmation": false
      },
      {
        "objID": "8de53d69-f8f2-d755-9604-6839be1d3612",
        "id": "a4e4d6f7-c8e5-4072-c32a-0fe68abbcbf3",
        "name": "Abort",
